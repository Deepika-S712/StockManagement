{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend (Spring Boot)",
      "type": "shell",
      "command": ".\\mvnw.cmd spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "smart-inventory",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Start Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "smart-inventory",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Run Smart Inventory Project",
      "dependsOn": [
        "Start Backend (Spring Boot)",
        "Start Frontend (Vite)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
